# SQLite-Datei relativ zum prisma/-Verzeichnis
DATABASE_URL="file:./dev.db"

# Basis-URL der Anwendung (ohne abschliessenden Slash)
NEXTAUTH_URL="http://localhost:3000"

# Zufälliges Secret, z.B. mit: openssl rand -base64 32
NEXTAUTH_SECRET="bitte-ersetzen"

# Initialer Superadmin, wird von `npm run db:seed` angelegt
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="bitte-ersetzen"
SEED_ADMIN_NAME="Allianz-Admin"

# Optionaler THP-Endpunkt (lastwarrank.com). Bleibt er leer, steht in der
# Übersicht der manuelle CSV/Paste-Import als Fallback bereit.
THP_API_URL="http://localhost:3777/api/rankings/players"
THP_SERVER_ID=""

# ── Allianz ─────────────────────────────────────────────────────────────
# Kürzel, Name und Servernummer. Ohne Eintrag zeigt die Oberfläche
# 'ALLY · Server #0000'. Füllt scripts/einrichten.sh aus.
NEXT_PUBLIC_ALLIANZ_TAG=""
NEXT_PUBLIC_ALLIANZ_NAME=""
NEXT_PUBLIC_SERVER_ID=""

# ── Datenquelle lastwarrank ─────────────────────────────────────────────
LWR_BASE_URL="https://lastwarrank.com"
LWR_ALLIANCE_ID=""
