# Vorlage. Füllt `scripts/einrichten.sh` aus – von Hand geht es auch.
# Diese Datei gehört ins Repository, die fertige `.env` nicht.

# SQLite-Datei relativ zum prisma/-Verzeichnis
DATABASE_URL="file:./dev.db"

# Basis-URL der Anwendung (ohne abschliessenden Slash). Muss die Adresse sein,
# unter der die Seite tatsächlich aufgerufen wird – sonst schlägt die Anmeldung
# ohne Fehlermeldung fehl.
NEXTAUTH_URL="http://localhost:3000"

# Zufälliges Secret, z.B. mit: openssl rand -base64 32
NEXTAUTH_SECRET="bitte-ersetzen"

# Initialer Superadmin, wird von `npm run db:seed` angelegt
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="bitte-ersetzen"
SEED_ADMIN_NAME="Allianz-Admin"

# ── Allianz ─────────────────────────────────────────────────────────────
# Kürzel, Name und Servernummer. Ohne Eintrag zeigt die Oberfläche
# 'ALLY · Server #0000'.
NEXT_PUBLIC_ALLIANZ_TAG=""
NEXT_PUBLIC_ALLIANZ_NAME=""
NEXT_PUBLIC_SERVER_ID=""

# ── Datenquelle lastwarrank ─────────────────────────────────────────────
# Server und Allianz-Kennung. Die Kennung ist die lange Zeichenfolge aus der
# Adresse der Allianzseite: https://lastwarrank.com/alliance/<Kennung>
LWR_BASE_URL="https://lastwarrank.com"
LWR_ALLIANCE_ID=""
THP_SERVER_ID=""

# Schnittstelle der Spieler-Rangliste. Leer lassen – dann wird sie aus
# LWR_BASE_URL abgeleitet. Nur setzen, wer eine eigene Instanz betreibt.
# (Hier stand einmal ein localhost-Dienst als Vorgabe: auf jedem anderen
# Rechner lauscht dort nichts, und der Abgleich blieb kommentarlos stumm.)
THP_API_URL=""

# ── Optional ────────────────────────────────────────────────────────────
# Erkennungsdienst für VS-Screenshots (siehe ocr/). Leer = keine Erkennung,
# die Punkte werden dann von Hand oder per Einfügen erfasst.
OCR_URL="http://127.0.0.1:3920"

# Discord-Webhook für Abwesenheitsmeldungen. Leer = keine Meldungen.
DISCORD_ABSENCE_WEBHOOK=""

# Auf "test" setzen, damit oben das sandfarbene Warnband erscheint. Gehört
# ausschliesslich in die .env des Testsystems, niemals in die der Live-Seite.
NEXT_PUBLIC_ENVIRONMENT=""

# Namensabgleich: wie viele Profile je Lauf einzeln abgefragt werden.
# Leer = alle. Senken, falls die Quelle die Last nicht mag.
NAMEN_EINZELN=""
